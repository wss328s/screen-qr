<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatRoot"
    android:orientation="vertical"
    android:background="@drawable/float_bg"
    android:padding="14dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="250dp"
    android:maxWidth="360dp">

    <!-- 标题栏：识别结果 + 复制（右上角小按钮） -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/floatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="识别结果"
            android:textSize="11sp"
            android:textColor="#B0FFFFFF"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:ellipsize="end"/>

        <Button
            android:id="@+id/copyBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="复制"
            android:textSize="11sp"
            android:textColor="#FFFFFFFF"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/clear_btn_bg"/>
    </LinearLayout>

    <!-- 内容：宽度随内容自适应（受 maxWidth 约束），内容多时换行增高，不截断行 -->
    <TextView
        android:id="@+id/qrContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="..."
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:lineSpacingExtra="3dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:maxLines="14"
        android:ellipsize="end"/>

    <!-- 底部：重置按钮（固定最小宽度并居中，不撑破悬浮窗宽度） -->
    <Button
        android:id="@+id/closeBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minWidth="220dp"
        android:minHeight="0dp"
        android:text="重置"
        android:textSize="12sp"
        android:textColor="#FF000000"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/btn_gradient"/>

</LinearLayout>
