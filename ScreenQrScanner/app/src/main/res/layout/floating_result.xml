<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatRoot"
    android:orientation="vertical"
    android:background="#E61F2937"
    android:padding="18dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="240dp"
    android:maxWidth="300dp">

    <!-- 状态行：圆点 + 状态文字 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/statusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/status_dot"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="监听中 · 等待二维码"
            android:textColor="#4CAF50"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- 提示文字 -->
    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="扫描中，请将二维码放入画面"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginTop="10dp"/>

    <!-- 列表 -->
    <TextView
        android:id="@+id/qrContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#D1D5DB"
        android:textSize="16sp"
        android:lineSpacingExtra="6dp"
        android:layout_marginTop="8dp"
        android:maxLines="12"/>

    <!-- 清除按钮 -->
    <TextView
        android:id="@+id/clearBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="清除"
        android:textColor="#FCA5A5"
        android:textSize="17sp"
        android:gravity="center"
        android:paddingVertical="14dp"
        android:background="@drawable/clear_btn_bg"
        android:layout_marginTop="14dp"/>

</LinearLayout>
